theme = Afterglow 
font-family = GeistMono NFM

macos-option-as-alt = true

keybind = cmd+a=unbind

keybind = cmd+a>v=new_split:right
keybind = cmd+a>s=new_split:down

keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right

keybind = alt+t=new_tab
keybind = alt+w=close_surface

keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

keybind = ctrl+digit_1=goto_tab:1
keybind = ctrl+digit_2=goto_tab:2
keybind = ctrl+digit_3=goto_tab:3
keybind = ctrl+digit_4=goto_tab:4
keybind = ctrl+digit_5=goto_tab:5
keybind = ctrl+digit_6=goto_tab:6
keybind = ctrl+digit_7=goto_tab:7

keybind = alt+p=toggle_command_palette
window-save-state = always
